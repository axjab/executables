#!/bin/bash
# ----- lumen -----
# Unified brightness control: laptop panel via brightnessctl,
# external monitors via ddcutil (VCP feature 10, luminosity).
# Automatically detects and controls ALL connected displays.
# Verbose by default; -q/-s silences informational output.
# No args: print current brightness for all displays and exit.

set -euo pipefail

QUIET=0
RETRIES=3
RETRY_DELAY=0.3
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/$(basename "$0").ddcutil.lock"
ICON=$'\U000f00e0'    # nf-md-brightness_7 (󰃠)

# ----- helpers -----

log() {
    (( QUIET )) && return 0
    printf '%s\n' "$*" >&2
}

die() { printf 'brightness: %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<EOF
usage: $(basename "$0") [-q|-s] <0-100>
       $(basename "$0")         show current brightness for all displays
       $(basename "$0") -h      show this help
EOF
    exit "${1:-1}"
}

get_chassis_symbol() {
    case "$1" in
        laptop) echo "" ;;
        convertible) echo "󰍺" ;;
        tablet) echo "" ;;
        handset) echo " フォン" ;;
        desktop) echo "" ;;
        server) echo "" ;;
        vm) echo "󰍳" ;;
        container) echo "󰍴" ;;
        embedded) echo "󰍵" ;;
        watch) echo "󰍶" ;;
        tv) echo "󰍷" ;;
        appliance) echo "󰍸" ;;
        pc) echo "" ;;
        *) echo "󰍹" ;;
    esac
}

# ----- args -----

while getopts ":qsh" opt; do
    case "$opt" in
        q|s) QUIET=1 ;;
        h)   usage 0 ;;
        *)   usage 1 ;;
    esac
done
shift $((OPTIND - 1))

(( $# <= 1 )) || usage 1
if [[ $# -eq 1 ]]; then
    LEVEL=$1
    [[ $LEVEL =~ ^[0-9]+$ && $LEVEL -ge 0 && $LEVEL -le 100 ]] || usage 1
fi

# ----- hardware detection helpers -----

has_laptop() {
    command -v brightnessctl &>/dev/null && brightnessctl -m &>/dev/null && [[ -n $(brightnessctl -m 2>/dev/null) ]]
}

get_external_displays() {
    command -v ddcutil &>/dev/null || return 0
    ddcutil detect --brief 2>/dev/null | awk '/^Display [0-9]+/{print $2}'
}

# Optional chassis log if available
CHASSIS=$(hostnamectl -j 2>/dev/null | jq -r '.Chassis // empty') || CHASSIS=""
[[ -n $CHASSIS ]] && log "$(get_chassis_symbol $CHASSIS) $CHASSIS"

# ----- read current -----

get_brightness() {
    local found=0

    if has_laptop; then
        local pct
        pct=$(brightnessctl -m | awk -F, '{gsub("%","",$4); print $4}')
        if [[ -n $pct ]]; then
            printf 'laptop: %s %s%%\n' "$ICON" "$pct"
            found=1
        fi
    fi

    local ext_displays
    ext_displays=$(get_external_displays)
    if [[ -n $ext_displays ]]; then
        for d in $ext_displays; do
            local cur max
            read -r cur max < <(ddcutil -d "$d" getvcp 10 --brief 2>/dev/null | awk '{print $4, $5}')
            if [[ -n ${cur:-} && -n ${max:-} && $max -gt 0 ]]; then
                printf 'external %s: %s %s%%\n' "$d" "$ICON" "$(( cur * 100 / max ))"
                found=1
            fi
        done
    fi

    (( found )) || die "no supported displays found"
}

# ----- write backends -----

set_brightness() {
    local controlled=0
    local fail=0

    # 1. Control laptop panel if present
    if has_laptop; then
        log "brightnessctl set ${LEVEL}%"
        brightnessctl set "${LEVEL}%" >/dev/null
        controlled=1
    fi

    # 2. Control external displays if present
    local ext_displays
    ext_displays=$(get_external_displays)
    if [[ -n $ext_displays ]]; then
        # ddcutil locking to prevent concurrent I2C bus access races
        exec {lock_fd}>"$LOCKFILE"
        flock -w 2 "$lock_fd" || die "another brightness update is in progress"

        local d attempt
        for d in $ext_displays; do
            attempt=0
            until ddcutil -d "$d" setvcp 10 "$LEVEL" >/dev/null 2>&1; do
                attempt=$((attempt + 1))
                log "display $d: setvcp failed (attempt $attempt/$RETRIES)"
                if (( attempt >= RETRIES )); then
                    echo "brightness: display $d failed after $RETRIES attempts" >&2
                    fail=1
                    break
                fi
                sleep "$RETRY_DELAY"
            done
            if (( attempt < RETRIES )); then
                log "display $d -> ${LEVEL}%"
            fi
        done
        controlled=1
    fi

    (( controlled )) || die "no supported displays found"
    (( fail )) && return 1
    return 0
}

# ----- dispatch -----

if [[ -z ${LEVEL:-} ]]; then
    get_brightness
    exit 0
fi

set_brightness
