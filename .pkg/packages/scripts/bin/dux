#!/usr/bin/env bash
set -euo pipefail

readonly VERSION='0.2.0'
output_file=${DISPLAYFILE:-${HOME:-/home/i}/etc/niri/outputs.kdl}

usage() {
    cat <<'USAGE'
Usage:
  dux help | -h
  dux version | -v
  dux                         Open the interactive menu
  dux profile [ls|stat|switch|new|edit|rm|mv]
  dux {display|-d} [stat|reset]

Profile commands default to the interactive profile menu. Profiles are KDL
files in the directory containing DISPLAYFILE's symlink target (normally
profiles/). The active profile is selected by the DISPLAYFILE symlink.

Environment:
  DISPLAYFILE   Path to the outputs.kdl symlink
                (default: ~/etc/niri/outputs.kdl)
USAGE
}

error() {
    printf 'dux: %s\n' "$*" >&2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        error "required command not found: $1"
        return 1
    }
}

validate_output_path() {
    case "$output_file" in
        ''|*/|.|..|*/.|*/..) error "expected a file path: $output_file"; return 1 ;;
    esac
    if [[ -d "$output_file" && ! -L "$output_file" ]]; then
        error "expected a file path: $output_file"
        return 1
    fi
}

profile_context() {
    local target output_dir
    [[ -L "$output_file" ]] || {
        error "not a symlink: $output_file"
        return 1
    }
    target=$(readlink -- "$output_file")
    if [[ "$target" == /* ]]; then
        PROFILE_DIR=$(dirname -- "$target")
    else
        PROFILE_DIR=$(dirname -- "$output_file")/$(dirname -- "$target")
    fi
    PROFILE_DIR=$(cd -- "$PROFILE_DIR" 2>/dev/null && pwd -P) || {
        error "profile directory does not exist: $PROFILE_DIR"
        return 1
    }
    ACTIVE_PROFILE=$(basename -- "$target")
    [[ -f "$PROFILE_DIR/$ACTIVE_PROFILE" ]] || {
        error "active profile does not exist: $PROFILE_DIR/$ACTIVE_PROFILE"
        return 1
    }
    output_dir=$(cd -- "$(dirname -- "$output_file")" && pwd -P)
    [[ "$PROFILE_DIR" == "$output_dir"/* ]] || {
        error "profile target must be inside the outputs directory: $PROFILE_DIR"
        return 1
    }
}

profile_path() {
    local name=$1
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.kdl$ ]] || {
        error "invalid profile name: $name (use letters, numbers, dots, underscores or hyphens)"
        return 1
    }
    [[ -f "$PROFILE_DIR/$name" ]] || {
        error "profile not found: $name"
        return 1
    }
    [[ ! -L "$PROFILE_DIR/$name" ]] || {
        error "profile must be a regular file, not a symlink: $name"
        return 1
    }
    printf '%s\n' "$PROFILE_DIR/$name"
}

profile_is_writable() {
    local mode
    mode=$(stat -c '%a' -- "$1") || return
    (( (8#$mode & 0222) != 0 ))
}

gum_choose() {
    command gum choose --header "Active profile: $ACTIVE_PROFILE" \
        --header.foreground '#CBA6F7' "$@"
}

gum_input() {
    command gum input --prompt "Active profile: $ACTIVE_PROFILE > " \
        --prompt.foreground '#CBA6F7' "$@"
}

gum_confirm() {
    command gum confirm --prompt.foreground '#CBA6F7' \
        "Active profile: $ACTIVE_PROFILE — $1"
}

profile_list() {
    local file name marker active
    active=$(basename -- "$(readlink -- "$output_file")")
    printf 'Profiles (%s active)\n\n' "$active"
    shopt -s nullglob
    for file in "$PROFILE_DIR"/*.kdl; do
        [[ -f "$file" && ! -L "$file" ]] || continue
        name=${file##*/}
        marker=''
        if ! profile_is_writable "$file"; then
            marker=' '
        fi
        if [[ "$name" == "$active" ]]; then
            printf '  ● %s%s\n' "$name" "$marker"
        else
            printf '  ○ %s%s\n' "$name" "$marker"
        fi
    done
    shopt -u nullglob
}

profile_stat() {
    local path mode state target
    target=$(readlink -- "$output_file")
    path="$PROFILE_DIR/$ACTIVE_PROFILE"
    if profile_is_writable "$path"; then
        state='READ/WRITE'
    else
        state='READ-ONLY '
    fi
    mode=$(stat -c '%A (%a)' -- "$path")
    printf 'Active:   %s\nTarget:   %s\nAccess:   %s\nMode:     %s\n' \
        "$ACTIVE_PROFILE" "$target" "$state" "$mode"
}

profile_switch() {
    local name path link_target temp_link parent
    name=$1
    path=$(profile_path "$name") || return
    parent=$(cd -- "$(dirname -- "$output_file")" && pwd -P)
    link_target="$PROFILE_DIR/$name"
    if [[ "$PROFILE_DIR" == "$parent"/* ]]; then
        link_target=${link_target#"$parent"/}
    fi
    temp_link="$parent/.${output_file##*/}.dux.$$"
    ln -s -- "$link_target" "$temp_link"
    if ! mv -Tf -- "$temp_link" "$output_file"; then
        rm -f -- "$temp_link"
        error "could not update $output_file"
        return 1
    fi
    ACTIVE_PROFILE=$name
    printf 'Active profile: %s\n' "$name"
}

profile_toggle() {
    local name path mode
    name=${1:-$ACTIVE_PROFILE}
    path=$(profile_path "$name") || return
    if profile_is_writable "$path"; then
        chmod a-w -- "$path"
        mode='READ-ONLY '
    else
        chmod u+rw,go-w -- "$path"
        mode='READ/WRITE'
    fi
    printf '%s: %s\n' "$name" "$mode"
}

profile_create() {
    local name path temp_file
    name=$1
    [[ "$name" == *.kdl ]] || name+='.kdl'
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.kdl$ ]] || {
        error "invalid profile name: $name"
        return 2
    }
    path="$PROFILE_DIR/$name"
    [[ ! -e "$path" && ! -L "$path" ]] || {
        error "profile already exists: $name"
        return 1
    }

    # Copy the active profile as it exists on disk, including any staged or
    # unstaged edits. A clean profile can be cloned too, which is useful when
    # the current layout simply does not match newly connected displays.
    temp_file=$(mktemp "$PROFILE_DIR/.dux-profile.XXXXXX")
    if [[ -f "$output_file" ]]; then
        if ! cp -- "$output_file" "$temp_file"; then
            rm -f -- "$temp_file"
            error "could not copy active profile: $ACTIVE_PROFILE"
            return 1
        fi
    else
        rm -f -- "$temp_file"
        error "display file is unavailable: $output_file"
        return 1
    fi
    if ! mv -- "$temp_file" "$path"; then
        rm -f -- "$temp_file"
        error "could not save profile: $name"
        return 1
    fi
    chmod u+rw,go-w -- "$path"
    printf 'Created writable profile: %s\n' "$name"
    profile_switch "$name"
}


profile_remove() {
    local name path
    name=$1
    path=$(profile_path "$name") || return
    if [[ "$name" == "$ACTIVE_PROFILE" ]]; then
        error "cannot remove the active profile; switch to another profile first"
        return 1
    fi
    require_command gum || return
    if ! gum_confirm "Remove profile '$name'?"; then
        printf 'Not removed: %s\n' "$name"
        return 0
    fi
    rm -- "$path"
    printf 'Removed profile: %s\n' "$name"
}

profile_rename() {
    local old_name new_name old_path new_path
    old_name=$1
    new_name=$2
    [[ "$new_name" == *.kdl ]] || new_name+='.kdl'
    [[ "$new_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.kdl$ ]] || {
        error "invalid profile name: $new_name"
        return 2
    }
    old_path=$(profile_path "$old_name") || return
    new_path="$PROFILE_DIR/$new_name"
    [[ ! -e "$new_path" && ! -L "$new_path" ]] || {
        error "profile already exists: $new_name"
        return 1
    }
    mv -- "$old_path" "$new_path"
    if [[ "$old_name" == "$ACTIVE_PROFILE" ]]; then
        if ! profile_switch "$new_name"; then
            mv -- "$new_path" "$old_path"
            return 1
        fi
    fi
    printf 'Renamed profile: %s -> %s\n' "$old_name" "$new_name"
}

profile_menu() {
    local choice name new_name
    require_command gum || return
    while true; do
        choice=$(gum_choose \
            "Show active profile" \
            "ls profiles" \
            "Switch profile" \
            "New profile" \
            "Toggle read/write" \
            "Remove profile" \
            "Rename profile" \
            "Quit") || return 0
        case "$choice" in
            'Show active profile') profile_stat ;;
            'ls profiles') profile_list ;;
            'Switch profile')
                name=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || continue
                profile_switch "$name"
                ;;
            'New profile')
                name=$(gum_input --placeholder 'Profile name (e.g. laptop)') || continue
                [[ -n "$name" ]] || continue
                profile_create "$name"
                ;;
            'Toggle read/write')
                name=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || continue
                profile_toggle "$name"
                ;;
            'Remove profile')
                name=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || continue
                profile_remove "$name" || continue
                ;;
            'Rename profile')
                name=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || continue
                new_name=$(gum_input --placeholder "New name for $name") || continue
                [[ -n "$new_name" ]] || continue
                profile_rename "$name" "$new_name" || continue
                ;;
            Quit) return 0 ;;
        esac
    done
}

display_command() {
    local action directory filename status
    action=${1:-stat}
    (( $# <= 1 )) || { usage >&2; return 2; }
    [[ "$action" == stat || "$action" == reset ]] || { usage >&2; return 2; }
    validate_output_path
    directory=$(dirname -- "$output_file")
    filename=${output_file##*/}
    while [[ ! -d "$directory" ]]; do
        [[ "$directory" != / ]] || { error "no existing parent directory for $output_file"; return 1; }
        filename="${directory##*/}/$filename"
        directory=$(dirname -- "$directory")
    done
    local -a git_cmd=(git --literal-pathspecs -C "$directory")

    case "$action" in
        stat)
            status=$("${git_cmd[@]}" status --short --no-renames --untracked-files=all --ignored=matching -- "$filename")
            if [[ -n "$status" ]]; then
                printf '%s\n' "$status"
            elif "${git_cmd[@]}" ls-files --error-unmatch -- "$filename" >/dev/null 2>&1; then
                printf 'Clean: %s\n' "$output_file"
            else
                printf 'No Git entry: %s\n' "$output_file"
            fi
            ;;
        reset)
            if [[ -L "$output_file" ]]; then
                local target target_dir target_file
                target=$(readlink -- "$output_file")
                if [[ "$target" == /* ]]; then
                    target_dir=$(dirname -- "$target")
                    target_file=$(basename -- "$target")
                else
                    target_dir=$(dirname -- "$output_file")/$(dirname -- "$target")
                    target_file=$(basename -- "$target")
                fi
                local -a target_git=(git --literal-pathspecs -C "$target_dir")
                if [[ $("${target_git[@]}" cat-file -t "HEAD:./$target_file" 2>/dev/null) != blob ]]; then
                    # New, uncommitted profiles have no HEAD version to restore.
                    error "profile has no committed version in HEAD: $target"
                    return 1
                fi
                "${target_git[@]}" restore --source=HEAD --staged --worktree -- "$target_file"
            else
                if [[ $("${git_cmd[@]}" cat-file -t "HEAD:./$filename" 2>/dev/null) != blob ]]; then
                    error "no file at this path in HEAD: $output_file"
                    return 1
                fi
                "${git_cmd[@]}" restore --source=HEAD --staged --worktree -- "$filename"
            fi
            printf 'Restored from HEAD: %s\n' "$output_file"
            ;;
    esac
}

main() {
    local command action new_name
    command=${1:-}
    case "$command" in
        help|-h)
            (( $# == 1 )) || { usage >&2; return 2; }
            usage
            ;;
        version|-v)
            (( $# == 1 )) || { usage >&2; return 2; }
            printf 'dux %s\n' "$VERSION"
            ;;
        display|-d)
            shift
            display_command "$@"
            ;;
        profile|profiles)
            shift
            validate_output_path
            profile_context
            action=${1:-menu}
            case "$action" in
                menu) (( $# == 0 )) || { usage >&2; return 2; }; profile_menu ;;
                ls) (( $# == 1 )) || { usage >&2; return 2; }; profile_list ;;
                stat|show|current) (( $# == 1 )) || { usage >&2; return 2; }; profile_stat ;;
                switch)
                    shift
                    if (( $# == 0 )); then
                        require_command gum || return
                        action=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || return 0
                    else
                        action=$1
                    fi
                    profile_switch "$action"
                    ;;
                new)
                    shift
                    if (( $# == 0 )); then
                        require_command gum || return
                        action=$(gum_input --placeholder 'Profile name (e.g. laptop)') || return 0
                    else
                        action=$1
                    fi
                    [[ -n "$action" ]] || { error 'profile name is required'; return 2; }
                    profile_create "$action"
                    ;;
                remove|rm)
                    shift
                    if (( $# == 0 )); then
                        require_command gum || return
                        action=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || return 0
                    else
                        action=$1
                        (( $# == 1 )) || { usage >&2; return 2; }
                    fi
                    profile_remove "$action"
                    ;;
                rename|mv)
                    shift
                    if (( $# == 0 )); then
                        require_command gum || return
                        action=$(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.kdl' -printf '%f\n' | sort | gum_choose) || return 0
                        new_name=$(gum_input --placeholder "New name for $action") || return 0
                        [[ -n "$new_name" ]] || { error 'new profile name is required'; return 2; }
                    elif (( $# == 2 )); then
                        action=$1
                        new_name=$2
                    else
                        usage >&2
                        return 2
                    fi
                    profile_rename "$action" "$new_name"
                    ;;
                edit|toggle)
                    shift
                    action=${1:-$ACTIVE_PROFILE}
                    (( $# <= 1 )) || { usage >&2; return 2; }
                    profile_toggle "$action"
                    ;;
                *) usage >&2; return 2 ;;
            esac
            ;;
        '')
            (( $# == 0 )) || { usage >&2; return 2; }
            validate_output_path
            profile_context
            profile_menu
            ;;
        *) usage >&2; return 2 ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
